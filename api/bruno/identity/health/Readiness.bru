meta {
  name: Readiness
  type: http
  seq: 2
}

get {
  url: {{identityBaseUrl}}/health/ready
  body: none
  auth: none
}

tests {
  test("is ready", function () {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("ok");
  });
}

docs {
  Every dependency answers. A failure (503) means "stop sending me traffic", not "restart me".
  The `checks` list is empty until real adapters (Postgres, Redis) register their checks.
}
