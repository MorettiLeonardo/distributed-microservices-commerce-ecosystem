meta {
  name: Password too short
  type: http
  seq: 2
}

post {
  url: {{identityBaseUrl}}/v1/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "short"
  }
}

tests {
  test("answers 422 with the domain error code", function () {
    expect(res.status).to.equal(422);
    expect(res.body.code).to.equal("PASSWORD_TOO_SHORT");
  });
}

docs {
  The shape is right but a business rule fails (domain): 422 with the domain's error code.
  Compare with **Validation failed** (400).
}
