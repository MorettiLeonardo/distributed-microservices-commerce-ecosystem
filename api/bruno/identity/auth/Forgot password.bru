meta {
  name: Forgot password
  type: http
  seq: 7
}

post {
  url: {{identityBaseUrl}}/v1/auth/forgot-password
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}"
  }
}

tests {
  test("is accepted", function () {
    expect(res.status).to.equal(202);
  });
}

docs {
  Always answers **202**, whether or not the email exists (anti-enumeration).

  Next: copy the password reset token from the email in Mailpit (http://localhost:8025) into the **emailToken** secret variable.
}
