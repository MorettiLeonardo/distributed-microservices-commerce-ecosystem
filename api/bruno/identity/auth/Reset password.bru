meta {
  name: Reset password
  type: http
  seq: 8
}

post {
  url: {{identityBaseUrl}}/v1/auth/reset-password
  body: json
  auth: none
}

body:json {
  {
    "token": "{{emailToken}}",
    "newPassword": "{{newPassword}}"
  }
}

tests {
  test("changes the password", function () {
    expect(res.status).to.equal(204);
  });
}

docs {
  Consumes the reset token (valid for 30 min, single use), changes the password and revokes every
  active session of the user. Log in again with **newPassword**.
}
