meta {
  name: Readiness
  type: http
  seq: 2
}

get {
  url: {{catalogBaseUrl}}/health/ready
  body: none
  auth: none
}

tests {
  test("is ready", function () {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("ok");
  });
}

docs {
  Postgres (catalog-db) and Redis (catalog-redis) answer. A failure (503) means "stop sending me
  traffic", not "restart me".
}
