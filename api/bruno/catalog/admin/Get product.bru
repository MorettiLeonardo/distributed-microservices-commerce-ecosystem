meta {
  name: Get product
  type: http
  seq: 5
}

get {
  url: {{catalogBaseUrl}}{{productLocation}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("productETag", res.headers.etag);
  }
}

tests {
  test("reads the product the Location pointed to, with its ETag", function () {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.equal(bru.getVar("productId"));
    expect(res.headers.etag).to.match(/^"\d+"$/);
  });
}

docs {
  Run **Create product** first: it follows the `Location` it returned.
  Any status is visible here (admin read); 404 for an unknown id, 400 for one that is not a UUID.
  The `ETag` is the product's version; changes must send it back as `If-Match`.
}
