meta {
  name: Create category
  type: http
  seq: 1
}

post {
  url: {{catalogBaseUrl}}/v1/admin/categories
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "{{categoryName}}"
  }
}

vars:pre-request {
  categoryName: Teste
}

script:pre-request {
  // Unique per run, so the collection can be run again without a 409.
  bru.setVar("categoryName", `Books ${Date.now()}`);
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("categoryId", res.body.id);
  }
}

tests {
  test("creates the category", function () {
    expect(res.status).to.equal(201);
    expect(res.body.id).to.be.a("string");
    expect(res.body.name).to.equal(bru.getVar("categoryName"));
  });
}

docs {
  Names have 1–60 characters (trimmed, 422 otherwise) and are unique ignoring case (409).
}
