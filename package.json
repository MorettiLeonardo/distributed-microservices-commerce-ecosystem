{
  "name": "ecommerce",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose -f infra/docker/compose.yaml up -d --wait",
    "infra:down": "docker compose -f infra/docker/compose.yaml down",
    "infra:reset": "docker compose -f infra/docker/compose.yaml down -v"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@ecommerce/tsconfig": "workspace:*",
    "@types/node": "^24.19.2",
    "lefthook": "^2.2.2",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.9",
    "typescript": "^7.0.2"
  }
}
