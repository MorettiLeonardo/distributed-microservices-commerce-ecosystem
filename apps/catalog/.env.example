# Copy to .env (git-ignored) and adjust. Defaults live in src/config.ts.
# Values below match infra/docker/compose.yaml.

NODE_ENV=development
PORT=3002
LOG_LEVEL=info

DATABASE_URL=postgres://catalog:catalog@localhost:5402/catalog
REDIS_URL=redis://localhost:6302

# Identity's public keys, used to verify access tokens locally (ADR 0013).
IDENTITY_JWKS_URL=http://localhost:3001/.well-known/jwks.json
# Must match identity's JWT_ISSUER / JWT_AUDIENCE.
# JWT_ISSUER=ecommerce-identity
# JWT_AUDIENCE=ecommerce
