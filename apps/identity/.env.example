# Copy to .env (git-ignored) and adjust. Defaults live in src/config.ts.
# Values below match infra/docker/compose.yaml and the infra/terraform outputs.

NODE_ENV=development
PORT=3001
LOG_LEVEL=info

DATABASE_URL=postgres://identity:identity@localhost:5401/identity
REDIS_URL=redis://localhost:6301

# AWS (Floci). Remove AWS_ENDPOINT_URL and the static keys against real AWS.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
IDENTITY_EVENTS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:ecommerce-identity-events
SEND_EMAIL_QUEUE_URL=http://localhost:4566/000000000000/ecommerce-notification-send-email

# ES256 private key (JWK). Generate one with:
#   pnpm -s --filter @ecommerce/identity keys:generate >> apps/identity/.env
JWT_PRIVATE_KEY=

# JWT_ISSUER=ecommerce-identity
# JWT_AUDIENCE=ecommerce
# ACCESS_TOKEN_TTL_SECONDS=900
# SESSION_TTL_DAYS=30
# BCRYPT_COST=12
